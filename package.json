{
  "name": "pirouter-dashboard",
  "version": "0.1.0",
  "description": "Touch-first Raspberry Pi router and backup status dashboard",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern prisma/generated",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "install:pi": "bash scripts/install-pi.sh",
    "install:mac-export": "bash scripts/install-portable-export-macos.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-sqlite3": "13.0.2",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
