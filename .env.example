# Local SQLite history. Keep this on the SSD with the application.
DATABASE_URL="file:./data/pirouter.db"

# Dashboard identity
DASHBOARD_NAME="PiRouter"
LOCATION_LABEL="Home network"

# Leave auto unless you want to force eth0, wlan0, or another interface.
NETWORK_INTERFACE="auto"
HEALTH_TARGET="1.1.1.1"

# Optional TCP endpoint check. This can be a LAN host, MagicDNS name, or IP.
ENDPOINT_LABEL="Internal service"
ENDPOINT_HOST="service.example"
ENDPOINT_PORT="443"

# Folder that contains Mac .sparsebundle/.backupbundle data.
TIME_MACHINE_PATH=""
TIME_MACHINE_SERVICE="smbd"

# A backup is considered stale after this many hours.
TIME_MACHINE_STALE_HOURS="36"
